# Teacher / escalation model: any OpenAI-compatible endpoint serving a large open model
TEACHER_BASE_URL=https://api.example.com/v1
TEACHER_API_KEY=
TEACHER_MODEL=

# Local model: native llama-server on the Mac (Metal)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=storeops-v2-q8_0
# From inside Docker containers use: http://host.docker.internal:8080/v1

# Store backend
STORE_DB_PATH=data/store.db
# Empty = compute forecasts in-process (same numbers as the stub service).
# Set to http://localhost:8001 when running store/forecast_stub.py (Docker Compose sets it).
FORECAST_URL=

# Gateway
GATEWAY_API_KEY=
ESCALATION_ENABLED=true
# Escalation endpoint defaults to the TEACHER_* settings; override with ESCALATION_BASE_URL,
# ESCALATION_API_KEY, ESCALATION_MODEL.
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_S=45
RATE_LIMIT_PER_MIN=60

# Training / tracking
HF_TOKEN=
WANDB_API_KEY=

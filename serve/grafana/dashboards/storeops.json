{
 "uid": "storeops",
 "title": "StoreOps Copilot",
 "tags": [
  "storeops"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests / min",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(copilot_requests_total[5m])) * 60",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Answered locally",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(copilot_requests_total{route=\"local\"}[5m])) / sum(rate(copilot_requests_total[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Escalated to large model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(copilot_requests_total{route=\"escalated\"}[5m])) / sum(rate(copilot_requests_total[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(copilot_request_seconds_bucket[5m])) by (le))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Latency by route (p50 / p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(copilot_request_seconds_bucket[5m])) by (le, route))",
     "legendFormat": "p50 {{route}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(copilot_request_seconds_bucket[5m])) by (le, route))",
     "legendFormat": "p95 {{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Requests by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(copilot_requests_total[1m])) by (route) * 60",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Escalations by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(copilot_escalations_total[5m])) by (reason)",
     "legendFormat": "{{reason}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Refused / failed tool calls by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(copilot_rejected_calls_total[5m])) by (reason)",
     "legendFormat": "{{reason}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Orders and transfers",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 13,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(copilot_orders_total[5m])) by (action)",
     "legendFormat": "{{action}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Tool calls by tool",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(copilot_tool_calls_total[5m])) by (tool, status)",
     "legendFormat": "{{tool}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "LLM tokens/s (llama.cpp)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(llamacpp:tokens_predicted_total[1m])",
     "legendFormat": "generated"
    },
    {
     "refId": "B",
     "expr": "rate(llamacpp:prompt_tokens_total[1m])",
     "legendFormat": "prompt (uncached)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "llama.cpp requests in flight",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "llamacpp:requests_processing",
     "legendFormat": "processing"
    },
    {
     "refId": "B",
     "expr": "llamacpp:requests_deferred",
     "legendFormat": "deferred"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}